{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "chromeDevtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    },
    "graphify": {
      "type": "stdio",
      "command": "C:\\Users\\Indigo\\Desktop\\diaverse\\.tools\\graphify\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "graphify.serve",
        "C:\\Users\\Indigo\\Desktop\\diaverse\\graphify-out\\graph.json"
      ]
    }
  }
}
